{
  "title": "Apple-Oat Muffins",
  "categories": ["baking", "sweet"],
  "ingredients": [
    "3/4 cup all-purpose flour",
    "1/2 cup rolled oats",
    "1tsp baking powder",
    "1/2tsp baking soda",
    "pinch of salt",
    "1tsp cinnamon",
    "1/4tsp nutmeg",
    "1/4 cup sugar",
    "1/3 cup of milk",
    "2 grated apples",
    "2 eggs",
    "some vanilla extract",
    "a bit of oil"
  ],
  "instructions": [
    "Mix dries and then wets, do not add baking powder nor soda yet.",
    "Add apples and oats.",
    "Let chill for a few minutes.",
    "Add soda and baking powder. Mix up, fill muffin trays.",
    "Bake a few mins at 180C."
  ],
  "fileName": "apple-oat-muffins"
}