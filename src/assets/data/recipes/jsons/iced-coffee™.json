{
  "title": "Iced Coffee",
  "categories": [
    "drink",
    "sweet",
    "vegetarian"
  ],
  "ingredients": [
    "50ml cold water",
    "1/4tsp sugar",
    "heaping tsp instant coffee",
    "1 tsp Monin syrup (eq. coconut)",
    "additional 90ml water",
    "80-90ml milk",
    "3 ice cubes"
  ],
  "instructions": [
    "Add the 50ml of water into the cup.",
    "Add sugar, syrup and coffee.",
    "Whisk with a milk frother until foamy.",
    "Gently pour in the rest of water and milk.",
    "Add ice and straw :) "
  ]
}
